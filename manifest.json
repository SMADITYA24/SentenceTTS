{
  "manifest_version": 3,
  "name": "SentenceTTS Reader",
  "version": "2.1.0",
  "description": "Reads any webpage or PDF aloud with live sentence highlighting — offline via your browser's voices, or online with Google Cloud Text-to-Speech (incl. English-India neural voices).",
  "permissions": ["storage", "activeTab", "nativeMessaging"],
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "https://texttospeech.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self';"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentenceTTS Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{d4e8a2b1-7c3f-4a9e-8b2f-5e6d7c8a9b0f}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": ["authenticationInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
